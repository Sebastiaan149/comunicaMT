{
  "name": "@comunica/actor-optimize-query-operation-smartkg-ship",
  "version": "5.1.3",
  "description": "A Comunica actor that optimizes query operations for Smart-KG by decomposing joins into stars and determining partition vs TPF shipping strategies",
  "lsd:module": true,
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index",
  "files": [
    "components",
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "lib/**/*.js.map"
  ],
  "scripts": {
    "build": "yarn run build:ts && yarn run build:components",
    "build:ts": "node \"../../node_modules/typescript/bin/tsc\"",
    "build:components": "componentsjs-generator"
  },
  "keywords": [
    "comunica",
    "actor",
    "optimize",
    "query-operation",
    "smartkg",
    "sparql"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@comunica/bus-optimize-query-operation": "^5.1.3",
    "@comunica/core": "^5.1.3",
    "@comunica/types": "^5.1.3",
    "@comunica/utils-algebra": "^5.1.3",
    "@rdfjs/types": "^1.0.0",
    "rdf-string": "^1.0.0"
  },
  "devDependencies": {
    "@comunica/context-entries": "^5.1.3",
    "@types/jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=14.0"
  }
}
